			},
			"isStartNode": false
		},
		{
			"interactiveButtonsHeader": {
				"type": "Text",
				"text": "Reflect & Apply – Bricks in Action!",
				"media": null
			},
			"interactiveButtonsBody": "<p>🏗️ A worker lays bricks in AP:</p>\n<p><br>\nDay 1 = 100 bricks<br>\n+20 bricks each day<br>\nTotal = 10,000 bricks</p>\n<p><br></p>\n<p>Can you find how many days it took?</p>\n<p><br></p>\n<p><strong>🔍 Use:</strong><br>\n• a = 100<br>\n• d = 20<br>\n• Sₙ = 10,000</p>\n<p><br></p>\n<p><br>\n→ Set up and solve the quadratic</p>\n<p><br>\n→ Find n = ? 🤔</p>",
